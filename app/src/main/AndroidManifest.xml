<manifest package="com.ahpalace.rentmanager" xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name="com.ahpalace.rentmanager.AhPalaceApplication"
        android:allowBackup="true"
        android:label="AH Palace Rent Manager"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity android:name="com.ahpalace.rentmanager.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
